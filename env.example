# Database Configuration (Digital Ocean)
MYSQL_HOST=your-mysql-host.db.ondigitalocean.com
MYSQL_PORT=25060
MYSQL_USER=your-username
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=your-database-name
MYSQL_SSL=true

# Application Settings
PARKING_HOURLY_RATE=40

# Authentication
JWT_SECRET=your-secret-key-change-in-production-use-long-random-string
ADMIN_EMAIL=admin@parking.com
ADMIN_PASSWORD=admin123

# Google OAuth (for user login)
# Use the same Client ID for both - get it from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

